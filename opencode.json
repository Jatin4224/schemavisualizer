{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".claude/CLAUDE.md"
  ],
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "ask",
      "npm run typecheck": "allow",
      "npm run lint": "allow",
      "npm run build": "allow",
      "npx tsc --noEmit": "allow",
      "npx prisma generate": "allow",
      "npx prisma validate": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "grep*": "allow",
      "rg*": "allow",
      "ls*": "allow",
      "cat*": "allow",
      "npx prisma migrate*": "ask",
      "npx prisma db push*": "ask",
      "rm*": "ask",
      "git push*": "ask",
      "git commit*": "ask"
    }
  }
}
